printf :: extern "printf" proc(fmt: *cchar, ...) -> int32;
rc_live :: extern "dray_rc_live" proc() -> int64;
puts :: extern "puts" proc(s: *cchar) -> int32;

say :: proc(text: []uint8) -> void {
    puts(cast(*cchar) text.ptr);
    return;
}

sum :: proc(xs: []int32) -> int32 {
    total := 0;
    for n in xs {
        total = total + n;
    }
    return total;
}

Maybe :: enum(comptime T: type) {
    Some(T),
    None,
}

Parent :: struct {
    id: int32,
    child: @Child,
}

Child :: struct {
    id: int32,
    parent: Weak(@Parent),
}

cycle_demo :: proc() -> int32 {
    c := alloc Child{ id: 2 };
    p := alloc Parent{ id: 1, child: c };
    c.parent = downgrade(p);

    printf(cast(*cchar) "allocations while linked: %d\n".ptr, rc_live());
    switch upgrade(c.parent) {
    case Maybe.Some(up):
        printf(cast(*cchar) "child can reach parent %d\n".ptr, up.id);
        return 0;
    case Maybe.None:
        printf(cast(*cchar) "parent already gone\n".ptr);
        return 1;
    }
}

main :: proc() -> int32 {
    greeting := "-- strings are slices --";
    say(greeting);
    printf(cast(*cchar) "the greeting is %d bytes\n".ptr, greeting.len);

    nums: [4]int32 = { 10, 20, 4, 3 };
    say("-- arrays and slices --");
    for n, [i] in nums {
        printf(cast(*cchar) "nums[%d] = %d\n".ptr, i, n);
    }

    view := nums[:];
    printf(cast(*cchar) "view.len = %d, sum = %d\n".ptr, view.len, sum(view));

    printf(cast(*cchar) "nums[1:3] sum = %d\n".ptr, sum(nums[1:3]));
    printf(cast(*cchar) "nums[2:]  sum = %d\n".ptr, sum(nums[2:]));
    printf(cast(*cchar) "view[:2]  sum = %d\n".ptr, sum(view[:2]));

    lo := 1;
    printf(cast(*cchar) "view[lo:] sum = %d\n".ptr, sum(view[lo:]));

    say("-- weak references --");
    n := cycle_demo();
    printf(cast(*cchar) "allocations after:        %d\n".ptr, rc_live());
    return n;
}
