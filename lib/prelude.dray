// prelude.dray
// Implicitly imported into every Dray program.
//
// These types are always in scope, unqualified, without an `import`. Compiler
// features build on them: `upgrade` and `try_alloc` produce a `Maybe`, and
// fallible operations return a `Result`.

// An optional value: `Some(x)` or nothing.
pub Maybe :: enum(comptime T: type) {
    Some(T),
    None,
}

// The outcome of a fallible operation: `Ok(value)` or `Err(error)`.
pub Result :: enum(comptime T: type, comptime E: type) {
    Ok(T),
    Err(E),
}
